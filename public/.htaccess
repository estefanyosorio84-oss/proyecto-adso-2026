<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    
    # Si el archivo o directorio existe, lo muestra
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Si no existe, manda todo a index.php para el ruteo MVC
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>